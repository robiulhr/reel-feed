{
  "name": "ecomgy-reel-feed",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "fetch": "tsx scripts/fetch.ts",
    "fetch:deep": "tsx scripts/fetch.ts --deep",
    "dev": "vite --host",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm run typecheck && npm test && npm run test:e2e",
    "lint": "biome check",
    "format": "biome check --write"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "happy-dom": "^21.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
